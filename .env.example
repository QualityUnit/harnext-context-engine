# Copy to .env and fill in. Never commit .env.

# --- Harness: which coding agent the builder runs (claude_code | codex) ---
MEANINGGRID_HARNESS=claude_code

# Claude Code harness (Claude Agent SDK). Required when MEANINGGRID_HARNESS=claude_code.
ANTHROPIC_API_KEY=
# Optional: model + caps for builder incorporation runs.
BUILDER_MODEL=claude-sonnet-4-6
BUILDER_MAX_TURNS=40
BUILDER_TIMEOUT_S=300

# Codex harness (later). Required when MEANINGGRID_HARNESS=codex.
OPENAI_API_KEY=

# --- Kafka / Redpanda ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Control-plane / metadata store (SQLite by default) ---
DATABASE_URL=sqlite+aiosqlite:///./data/meaninggrid.sqlite

# --- AgentFS: per-org context filesystem store ---
# One store per org under this dir. Backend is chosen by AGENTFS_BACKEND:
#   agentfs — Turso AgentFS SQLite .db per org, mounted via `agentfs exec` (default)
#   git     — a git-backed directory per org (no agentfs binary; used by tests)
AGENTFS_DIR=./data/agentfs
AGENTFS_BACKEND=agentfs
AGENTFS_BIN=agentfs   # falls back to ~/.cargo/bin/agentfs if not on PATH

# --- Ingest API ---
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3100
OAUTH_REDIRECT_BASE=http://localhost:8000

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
# "Sign in with Google" — register a Google Cloud OAuth client (Web application).
# Authorized redirect URI: http://localhost:8000/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Integration OAuth apps (register your own; leave blank to use the manual path) ---
# GitHub OAuth App callback URL:  http://localhost:8000/oauth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Slack App redirect URL:         http://localhost:8000/oauth/slack/callback
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
# Discord OAuth App redirect URL: http://localhost:8000/oauth/discord/callback
# (scope "bot"; bot perms View Channel + Read Message History). DISCORD_BOT_TOKEN
# is the bot's token (Developer Portal → Bot) — enable its Message Content intent.
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# --- MCP server (multi-tenant; tenant resolved per-request from the bearer token) ---
MCP_HOST=0.0.0.0
MCP_PORT=8765
# Public URL of the MCP server, shown in the dashboard's Connect panel.
MCP_PUBLIC_URL=http://localhost:8765/mcp
# JWT_SECRET (above) also signs/verifies the per-project MCP bearer tokens.

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Copy to .env and fill in. Never commit .env.

# --- LLM / Embedder (Graphiti) ---
OPENAI_API_KEY=

# --- Kafka / Redpanda ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- FalkorDB (graph store for Graphiti) ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# --- MinIO (object storage for blobs) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=meaninggrid
MINIO_SECRET_KEY=meaninggrid_dev
MINIO_BUCKET=meaninggrid-blobs

# --- OLTP store (SQLite by default; swap to Postgres later) ---
DATABASE_URL=sqlite+aiosqlite:///./data/meaninggrid.sqlite

# --- FAISS (per-tenant on-disk vector index; worker writes, API reads) ---
FAISS_DIR=./data/faiss

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Harnext — production env. Copy to `.env` and fill in.
#   cp .env.production.example .env

# ---- public URLs (behind the shared nginx) ---------------------------------
# Single domain, path-routed: / -> web, /api -> ingest, /mcp -> mcp.
WEB_ORIGIN=https://app.harnext.dev
OAUTH_REDIRECT_BASE=https://app.harnext.dev/api
MCP_PUBLIC_URL=https://app.harnext.dev/mcp
# Client calls the API on the same origin via the proxy — keep relative.
NEXT_PUBLIC_API_BASE_URL=/api

# ---- secrets ---------------------------------------------------------------
# Signs user sessions AND the per-project MCP bearer tokens. Generate a strong
# value:  openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32

# ---- infra / storage -------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
# Celery broker/backend for the polling scheduler (poller-worker + poller-beat).
REDIS_URL=redis://redis:6379/0
DATABASE_URL=sqlite+aiosqlite:////app/data/harnext.sqlite
AGENTFS_DIR=/app/data/agentfs
# 'git' needs no external binary or FUSE — one git repo per org, snapshots=commits.
AGENTFS_BACKEND=git

# Website-crawl tasks share the scheduler's Redis (REDIS_URL) + worker.
# Crawl politeness (defaults are sane; override to tune the budget):
# CRAWL_MAX_PAGES=50
# CRAWL_DELAY_SECONDS=1.0
# CRAWL_RATE_LIMIT=30/m

# ---- access ----------------------------------------------------------------
# Invite-only: self-serve signup is disabled. Create accounts with
#   ./scripts/create-user.sh <email> [name]
# Set true only if you want the public /register form + endpoint enabled.
REGISTRATION_OPEN=false

# ---- closed beta / webinar registration (Mailchimp) ------------------------
# While Harnext isn't GA, the /register page collects name + email and tags the
# contact in an existing Mailchimp audience (no new audience, nothing stored
# locally). Set the API key to enable POST /beta/signup.
# MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us21
MAILCHIMP_AUDIENCE_ID=485db66a95
MAILCHIMP_BETA_TAG=harnext-closed-beta

# ---- harness ---------------------------------------------------------------
# claude_code drives the Claude CLI, authenticated by the OAuth token you place
# at secrets/claude-credentials.json (your ~/.claude/.credentials.json). No
# ANTHROPIC_API_KEY required. Set HARNEXT_HARNESS=fake for a no-LLM smoke run.
HARNEXT_HARNESS=claude_code
BUILDER_MODEL=claude-sonnet-4-6
# harnext drives the `harnext` CLI (npm i -g harnext) at any provider/model — e.g.
# OpenRouter. Set HARNEXT_HARNESS=harnext and provide:
# HARNEXT_PROVIDER=openrouter
# HARNEXT_MODEL=anthropic/claude-sonnet-4.5
# HARNEXT_API_KEY_ENV=OPENROUTER_API_KEY
# OPENROUTER_API_KEY=
# (or NVIDIA NIM: HARNEXT_PROVIDER=nvidia, HARNEXT_API_KEY_ENV=NVIDIA_API_KEY, NVIDIA_NIM_API_KEY=)

# ---- OAuth providers (optional; email/password works without these) --------
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# SLACK_OAUTH_CLIENT_ID=
# SLACK_OAUTH_CLIENT_SECRET=
# Discord: OAuth app (redirect https://<domain>/api/oauth/discord/callback, scope
# "bot", perms View Channel + Read Message History) + the bot token. Enable the
# bot's Message Content privileged intent so it can read message text.
# DISCORD_OAUTH_CLIENT_ID=
# DISCORD_OAUTH_CLIENT_SECRET=
# DISCORD_BOT_TOKEN=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Slack Events API (real-time messages). Set to your Slack app's Signing Secret
# to enable POST /webhooks/slack; then point the app's Event Subscriptions URL at
# https://<domain>/api/webhooks/slack and subscribe to message.channels.
# SLACK_SIGNING_SECRET=

# GitHub webhook (real-time commits/issues/PRs). Set any random string here AND
# as the repo webhook's Secret; point the webhook at https://<domain>/api/webhooks/github
# (content type application/json) and send Pushes/Issues/Pull requests/Issue comments.
# GITHUB_WEBHOOK_SECRET=

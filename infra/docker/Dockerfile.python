# One image for all four Python services (ingest / classifier / builder / mcp).
# They share the uv workspace, so the image carries the whole workspace venv and
# each compose service just overrides the command.
#
# Build from the repo root:
#   docker build -f infra/docker/Dockerfile.python -t harnext-py .

# ---- build stage: resolve + install the workspace into /app/.venv ----------
FROM python:3.12-slim-bookworm AS build

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PIP_ROOT_USER_ACTION=ignore

RUN pip install --no-cache-dir "uv>=0.6"

WORKDIR /app

# Lock + workspace manifests first (cache-friendly), then sources.
COPY pyproject.toml uv.lock ./
COPY packages ./packages
COPY apps/ingest ./apps/ingest
COPY apps/classifier ./apps/classifier
COPY apps/builder ./apps/builder
COPY apps/mcp ./apps/mcp

# Install every workspace member's runtime deps (no dev tools).
RUN uv sync --frozen --all-packages --no-dev

# ---- runtime stage ---------------------------------------------------------
FROM python:3.12-slim-bookworm AS runtime

# git              -> the AgentFS "git" backend (one repo per org; snapshots = commits)
# node             -> the Claude Code CLI (Agent SDK shells out to it) and the
#                     harnext CLI (the harnext harness shells out to it, e.g. to
#                     drive OpenRouter). Both are installed globally below. The
#                     harnext SDK pin in apps/builder/pyproject.toml must match the
#                     CLI version here (HARNEXT_NO_CLI_AUTOUPDATE disables the SDK's
#                     npm self-upgrade, which can't run as the non-root app user).
# gosu             -> drop from root (needed to chown mounted volumes) to the app user
#                     (Claude Code refuses --dangerously-skip-permissions as root)
# bubblewrap+socat -> the Claude Code bash sandbox (the builder allows Bash, but
#                     OS-sandboxed: writes confined to the working dir, network
#                     denied). Missing them makes sandbox init fail; the harness
#                     sets failIfUnavailable so that errors out rather than
#                     silently running Bash unconfined.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates gosu curl gnupg bubblewrap socat \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g @anthropic-ai/claude-code harnext@1.5.0 \
    && apt-get purge -y gnupg \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 1000 app \
    && git config --system --add safe.directory '*'

WORKDIR /app
COPY --from=build /app /app
COPY infra/docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    HARNEXT_NO_CLI_AUTOUPDATE=1 \
    HOME=/home/app \
    GIT_AUTHOR_NAME=harnext \
    GIT_AUTHOR_EMAIL=builder@harnext.local \
    GIT_COMMITTER_NAME=harnext \
    GIT_COMMITTER_EMAIL=builder@harnext.local

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
# Default command is the ingest API; other services override `command:` in compose.
CMD ["uvicorn", "harnext_ingest.main:app", "--host", "0.0.0.0", "--port", "8000"]
